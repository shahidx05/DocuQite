# ── Database ──────────────────────────────────────────────────────────
# Full PostgreSQL connection URL including driver (psycopg v3).
DATABASE_URL=postgresql+psycopg://rag:ragpass@localhost:5432/ragdb

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# ── LLM provider ──────────────────────────────────────────────────────
# Which LLM backend to use. Only "gemini" is supported in Phase 0.
LLM_PROVIDER=gemini

# Your Gemini API key — keep this secret, never commit!
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to call for generation (set a real model name before use).
GEMINI_MODEL=gemini-1.5-flash

# ── Embeddings & reranking ────────────────────────────────────────────
# fastembed model name for dense embeddings.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Cross-encoder model name for reranking.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Chunking & retrieval ──────────────────────────────────────────────
# Token / character count per chunk.
CHUNK_SIZE=512

# Overlap between consecutive chunks.
CHUNK_OVERLAP=64

# Number of candidates to retrieve from the vector store before reranking.
RETRIEVAL_TOP_K=20

# Number of results to keep after the reranker.
RERANK_TOP_N=5

# ── Upload / ingestion ────────────────────────────────────────────────
# Maximum upload file size in megabytes.
MAX_UPLOAD_MB=25

# Directory where uploaded files are stored (relative to backend/).
UPLOAD_DIR=data/uploads

# ── Auth ──────────────────────────────────────────────────────────────
# Change this to a long random string before going to production.
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# JWT access token lifetime in minutes (default 60 = 1 hour).
JWT_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────
# "development" | "production"
APP_ENV=development
