# ── Database ──────────────────────────────────────────────────────────
# Full PostgreSQL connection URL including driver (psycopg v3).
DATABASE_URL=postgresql+psycopg://rag:ragpass@localhost:5432/ragdb

# ── Qdrant ────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Dev collection (tests use rag_chunks_test automatically).
QDRANT_COLLECTION=rag_chunks

# ── LLM provider ──────────────────────────────────────────────────────
# Which LLM backend to use: "gemini" | "mock" (default: "mock").
# When "mock", no API key or network access is needed.
LLM_PROVIDER=mock

# Your Gemini API key — required only when LLM_PROVIDER=gemini. Never commit!
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to call for generation (current Gemini Flash).
GEMINI_MODEL=gemini-3.8-flash

# Maximum time in seconds to wait for LLM response.
LLM_TIMEOUT_SECONDS=30

# Cost calculation per 1M tokens (0.0 for mock)
LLM_PRICE_INPUT_PER_1M=0.0
LLM_PRICE_OUTPUT_PER_1M=0.0

# ── Embeddings & reranking ────────────────────────────────────────────
# fastembed bi-encoder model name for dense embeddings.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Output dimension of the dense model (must match the model).
EMBEDDING_DIM=384

# fastembed sparse model name (BM25).
SPARSE_MODEL=Qdrant/bm25

# Number of chunks to embed in one batch.
EMBED_BATCH_SIZE=32

# Cross-encoder model name for reranking (Phase 4).
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Whether reranking is enabled by default.
RERANK_ENABLED=true

# Minimum cross-encoder score to trigger LLM answer generation (calibrated).
MIN_RERANK_SCORE=0.0

# ── Chunking & retrieval ──────────────────────────────────────────────
# Token / character count per chunk.
CHUNK_SIZE=512

# Overlap between consecutive chunks.
CHUNK_OVERLAP=64

# Chunker implementation: "custom" | "langchain" (default: "custom").
CHUNKER=custom

# Number of candidates to retrieve from the vector store before reranking.
RETRIEVAL_TOP_K=20

# Number of results to keep after the reranker.
RERANK_TOP_N=5

# Maximum character count of retrieved context sent to the LLM.
MAX_CONTEXT_CHARS=6000

# ── Privacy / redaction ───────────────────────────────────────────────
# Whether to redact emails, phone numbers, and roll numbers during cleaning.
REDACT_PII=true

# ── Upload / ingestion ────────────────────────────────────────────────
# Maximum upload file size in megabytes.
MAX_UPLOAD_MB=25

# Directory where uploaded files are stored (relative to backend/).
UPLOAD_DIR=data/uploads

# ── Auth ──────────────────────────────────────────────────────────────
# Change this to a long random string before going to production.
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# JWT access token lifetime in minutes (default 60 = 1 hour).
JWT_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────
# "development" | "production"
APP_ENV=development
